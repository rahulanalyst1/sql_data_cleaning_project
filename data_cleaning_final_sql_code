-- using cte with to check the num of duplicate window function row_number beacuse it give the unique number to every rows and do not skip tie 
with CTE as (
select *,
row_number() over(partition by transaction_id order by transaction_id) row_num
from sales
)

delete from CTE 
where row_num > 1

select *
from CTE
where row_num > 1

